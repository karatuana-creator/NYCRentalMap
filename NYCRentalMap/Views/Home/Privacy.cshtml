@{
    ViewData["Title"] = "Gizlilik Politikası";
}

<div class="privacy-container" style="padding: 2.5rem 1.5rem; max-width: 900px; margin: 0 auto; color: var(--text-primary);">
    <h1 style="margin-bottom: 1.5rem; color: var(--text-primary); font-size: 1.8rem; font-weight: 700;">🔒 @ViewData["Title"]</h1>

    <div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1.5rem; line-height: 1.6; color: var(--text-secondary);">
        <p style="margin-bottom: 1rem;">
            Bu uygulama, New York Şehri kiralık ev verilerini harita üzerinde görselleştirmek amacıyla geliştirilmiştir.
        </p>
        <p style="margin-bottom: 1rem;">
            Kullanıcıların kişisel verileri toplanmamakta veya üçüncü taraflarla paylaşılmamaktadır.
        </p>
    </div>
</div>
