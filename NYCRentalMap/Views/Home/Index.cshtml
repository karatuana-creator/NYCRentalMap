@{
    ViewData["Title"] = "New York Ev Kiraları Analiz Dashboardu";
}

<div class="dashboard-grid sidebar-hidden" id="dashboardGrid">

    <!-- 1. LEFT SIDEBAR: FILTERS & POPULAR WIDGET -->
    <aside class="sidebar-panel">
        <div class="filter-card">
            <div class="filter-header">
                <h3>Filtreler</h3>
                <button type="button" class="btn-text-danger" id="btnClearAllFilters" onclick="appUI.clearFilters()">Temizle</button>
            </div>

            <!-- Price Range -->
            <div class="filter-group">
                <label class="filter-label">Fiyat Aralığı (gecelik)</label>
                <div class="range-display">
                    <span id="minPriceVal">$0</span>
                    <span id="maxPriceVal">$10.000+</span>
                </div>
                <div class="range-slider-box">
                    <input type="range" id="priceRangeInput" min="0" max="10000" step="50" value="10000" oninput="appUI.updatePriceLabel(this.value)" />
                </div>
                <div class="range-badge-val" id="rangeBadgeText">$10 - $10.000+</div>
            </div>

            <!-- Room Types -->
            <div class="filter-group">
                <label class="filter-label">Oda Tipi</label>
                <div class="checkbox-list">
                    <label class="custom-checkbox">
                        <input type="checkbox" id="chkRoomAll" checked onchange="appUI.toggleAllRoomTypes(this)" />
                        <span class="lbl-text">Tümü</span>
                    </label>
                    <label class="custom-checkbox">
                        <input type="checkbox" class="chk-room" value="Entire home/apt" checked onchange="appUI.onRoomTypeChange()" />
                        <span class="lbl-text">Entire Home (Tüm Ev)</span>
                    </label>
                    <label class="custom-checkbox">
                        <input type="checkbox" class="chk-room" value="Private room" checked onchange="appUI.onRoomTypeChange()" />
                        <span class="lbl-text">Private Room (Özel Oda)</span>
                    </label>
                    <label class="custom-checkbox">
                        <input type="checkbox" class="chk-room" value="Shared room" checked onchange="appUI.onRoomTypeChange()" />
                        <span class="lbl-text">Shared Room (Paylaşımlı Oda)</span>
                    </label>
                </div>
            </div>

            <!-- Neighborhood -->
            <div class="filter-group">
                <label class="filter-label">Mahalle</label>
                <select id="selBorough" class="custom-select" onchange="appUI.fetchData()">
                    <option value="">Tümü</option>
                    <option value="Manhattan">Manhattan</option>
                    <option value="Brooklyn">Brooklyn</option>
                    <option value="Queens">Queens</option>
                    <option value="Bronx">Bronx</option>
                    <option value="Staten Island">Staten Island</option>
                </select>
            </div>

            <!-- Minimum Nights -->
            <div class="filter-group">
                <label class="filter-label">Minimum Gece</label>
                <select id="selMinNights" class="custom-select" onchange="appUI.fetchData()">
                    <option value="">Tümü</option>
                    <option value="1">1 Gece</option>
                    <option value="2">2 Gece</option>
                    <option value="3">3+ Gece</option>
                    <option value="7">7+ Gece</option>
                    <option value="30">30+ Gece</option>
                </select>
            </div>

            <!-- Reviews Range -->
            <div class="filter-group">
                <label class="filter-label">Yorum Sayısı</label>
                <div class="range-slider-box">
                    <input type="range" id="reviewsRangeInput" min="0" max="500" step="5" value="0" oninput="appUI.updateReviewsLabel(this.value)" />
                </div>
                <div class="range-badge-val" id="reviewsBadgeText">0 - 1000+</div>
            </div>

            <!-- Guests & Pets Counter Breakdown (Airbnb Style) -->
            <div class="filter-group">
                <label class="filter-label" style="display:flex; justify-content:space-between; align-items:center;">
                    <span>Misafirler & Kişiler</span>
                    <small style="color:var(--accent-red); font-weight:700;" id="totalGuestsCountTxt">0 Misafir</small>
                </label>
                
                <div class="guest-counters-box" style="background:var(--bg-input); border:1px solid var(--border-color); border-radius:12px; padding:0.75rem; display:flex; flex-direction:column; gap:0.6rem;">
                    <!-- Adults -->
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <div>
                            <div style="font-weight:700; font-size:0.8rem; color:var(--text-main);">Yetişkinler</div>
                            <div style="font-size:0.68rem; color:var(--text-muted);">13 yaş ve üstü</div>
                        </div>
                        <div style="display:flex; align-items:center; gap:0.5rem;">
                            <button type="button" class="btn-counter-sm" onclick="appUI.updateGuestCount('adults', -1)">-</button>
                            <span style="font-weight:800; font-size:0.85rem; width:16px; text-align:center;" id="cntAdults">0</span>
                            <button type="button" class="btn-counter-sm" onclick="appUI.updateGuestCount('adults', 1)">+</button>
                        </div>
                    </div>

                    <!-- Children -->
                    <div style="display:flex; justify-content:space-between; align-items:center; border-top:1px dashed var(--border-color); padding-top:0.4rem;">
                        <div>
                            <div style="font-weight:700; font-size:0.8rem; color:var(--text-main);">Çocuklar</div>
                            <div style="font-size:0.68rem; color:var(--text-muted);">2-12 yaş</div>
                        </div>
                        <div style="display:flex; align-items:center; gap:0.5rem;">
                            <button type="button" class="btn-counter-sm" onclick="appUI.updateGuestCount('children', -1)">-</button>
                            <span style="font-weight:800; font-size:0.85rem; width:16px; text-align:center;" id="cntChildren">0</span>
                            <button type="button" class="btn-counter-sm" onclick="appUI.updateGuestCount('children', 1)">+</button>
                        </div>
                    </div>

                    <!-- Babies -->
                    <div style="display:flex; justify-content:space-between; align-items:center; border-top:1px dashed var(--border-color); padding-top:0.4rem;">
                        <div>
                            <div style="font-weight:700; font-size:0.8rem; color:var(--text-main);">Bebekler</div>
                            <div style="font-size:0.68rem; color:var(--text-muted);">2 yaş altı</div>
                        </div>
                        <div style="display:flex; align-items:center; gap:0.5rem;">
                            <button type="button" class="btn-counter-sm" onclick="appUI.updateGuestCount('babies', -1)">-</button>
                            <span style="font-weight:800; font-size:0.85rem; width:16px; text-align:center;" id="cntBabies">0</span>
                            <button type="button" class="btn-counter-sm" onclick="appUI.updateGuestCount('babies', 1)">+</button>
                        </div>
                    </div>

                    <!-- Pets -->
                    <div style="display:flex; justify-content:space-between; align-items:center; border-top:1px dashed var(--border-color); padding-top:0.4rem;">
                        <div>
                            <div style="font-weight:700; font-size:0.8rem; color:var(--text-main);">Evcil hayvanlar</div>
                            <div style="font-size:0.65rem; color:var(--text-muted);">Evcil hayvan dostu</div>
                        </div>
                        <div style="display:flex; align-items:center; gap:0.5rem;">
                            <button type="button" class="btn-counter-sm" onclick="appUI.updateGuestCount('pets', -1)">-</button>
                            <span style="font-weight:800; font-size:0.85rem; width:16px; text-align:center;" id="cntPets">0</span>
                            <button type="button" class="btn-counter-sm" onclick="appUI.updateGuestCount('pets', 1)">+</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Keyword -->
            <div class="filter-group">
                <label class="filter-label">Anahtar Kelime</label>
                <div class="input-with-btn-group">
                    <input type="text" id="keywordInput" class="custom-input" placeholder="Semt, ev adı, açıklama..." onkeyup="if(event.key==='Enter') appUI.fetchData()" />
                    <button type="button" class="btn-search-inline" title="Hızlı Ara" onclick="appUI.fetchData()"><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
            </div>

            <!-- Submit Button -->
            <button type="button" class="btn-primary-coral w-100 btn-filter-submit" id="btnFilterSubmit" onclick="appUI.fetchData(1, true)"><i class="fa-solid fa-magnifying-glass"></i> Ara & Filtrele</button>
        </div>

        <!-- Widget: En Popüler Evler (Pro Card Version) -->
        <div class="popular-widget-card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 1rem;">
                <h4 class="widget-title" style="margin:0; font-size:0.95rem; font-weight:800; display:flex; align-items:center; gap:0.4rem;">
                    <i class="fa-solid fa-fire" style="color: var(--accent-red);"></i> <span>En Popüler İlanlar</span>
                </h4>
                <span style="font-size:0.68rem; background:rgba(244,63,94,0.15); color:var(--accent-red); font-weight:700; padding:2px 8px; border-radius:12px;">Top 3</span>
            </div>
            
            <div class="popular-list" id="popularListContainer">
                <div class="popular-item-pro" onclick="appUI.selectPropertyById(1)">
                    <div class="rank-badge-pro rank-1">1</div>
                    <div class="pop-thumb-wrap">
                        <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=300&q=80" class="pop-thumb-pro" alt="Lüks Daire" />
                    </div>
                    <div class="pop-info-pro">
                        <h5 title="Lüks Manhattan Dairesi">Lüks Manhattan Dairesi</h5>
                        <div class="pop-location">📍 Manhattan, NYC</div>
                        <div class="pop-meta">
                            <span><i class="fa-solid fa-star icon-star"></i> 4.98</span>
                            <span class="pop-price">$350 <small>/ gece</small></span>
                        </div>
                    </div>
                </div>

                <div class="popular-item-pro" onclick="appUI.selectPropertyById(2)">
                    <div class="rank-badge-pro rank-2">2</div>
                    <div class="pop-thumb-wrap">
                        <img src="https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?auto=format&fit=crop&w=300&q=80" class="pop-thumb-pro" alt="Harlem Ev" />
                    </div>
                    <div class="pop-info-pro">
                        <h5 title="Harlem'de Mükemmel Ev">Harlem'de Mükemmel Ev</h5>
                        <div class="pop-location">📍 Harlem, Manhattan</div>
                        <div class="pop-meta">
                            <span><i class="fa-solid fa-star icon-star"></i> 4.95</span>
                            <span class="pop-price">$180 <small>/ gece</small></span>
                        </div>
                    </div>
                </div>

                <div class="popular-item-pro" onclick="appUI.selectPropertyById(3)">
                    <div class="rank-badge-pro rank-3">3</div>
                    <div class="pop-thumb-wrap">
                        <img src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?auto=format&fit=crop&w=300&q=80" class="pop-thumb-pro" alt="Brooklyn Loft" />
                    </div>
                    <div class="pop-info-pro">
                        <h5 title="Brooklyn Loft">Brooklyn Loft</h5>
                        <div class="pop-location">📍 Williamsburg, Brooklyn</div>
                        <div class="pop-meta">
                            <span><i class="fa-solid fa-star icon-star"></i> 4.93</span>
                            <span class="pop-price">$160 <small>/ gece</small></span>
                        </div>
                    </div>
                </div>
            </div>
            <button type="button" class="btn-popular-see-all" onclick="appUI.switchTab('explore')">
                <span>Tüm Popüler Evleri Gör</span> <i class="fa-solid fa-chevron-right"></i>
            </button>
        </div>
    </aside>

    <!-- 2. CENTER MAIN DASHBOARD: KPIS, CHARTS, LISTINGS, BOTTOM CHARTS -->
    <div class="center-content">

        <!-- 6 KPI Metric Cards Row -->
        <section class="kpi-grid">
            <div class="kpi-card">
                <div class="kpi-icon icon-pink"><i class="fa-solid fa-house"></i></div>
                <div class="kpi-details">
                    <span class="kpi-title">Toplam Ev</span>
                    <h3 class="kpi-val" id="kpiTotalHouses">48.895</h3>
                    <small class="kpi-sub">%100 veri seti</small>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon icon-green"><i class="fa-solid fa-dollar-sign"></i></div>
                <div class="kpi-details">
                    <span class="kpi-title">Ortalama Fiyat</span>
                    <h3 class="kpi-val" id="kpiAvgPrice">$152</h3>
                    <small class="kpi-sub">Gecelik ortalama</small>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon icon-orange"><i class="fa-solid fa-crown"></i></div>
                <div class="kpi-details">
                    <span class="kpi-title">En Pahalı Ev</span>
                    <h3 class="kpi-val" id="kpiMaxPrice">$10.000+</h3>
                    <small class="kpi-sub">Gecelik fiyat</small>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon icon-mint"><i class="fa-solid fa-tag"></i></div>
                <div class="kpi-details">
                    <span class="kpi-title">En Ucuz Ev</span>
                    <h3 class="kpi-val" id="kpiMinPrice">$10</h3>
                    <small class="kpi-sub">Gecelik fiyat</small>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon icon-blue"><i class="fa-solid fa-comments"></i></div>
                <div class="kpi-details">
                    <span class="kpi-title">Toplam Yorum</span>
                    <h3 class="kpi-val" id="kpiTotalReviews">1.52M</h3>
                    <small class="kpi-sub">Tüm evler için</small>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon icon-purple"><i class="fa-solid fa-star"></i></div>
                <div class="kpi-details">
                    <span class="kpi-title">Ortalama Puan</span>
                    <h3 class="kpi-val" id="kpiAvgRating">4.62</h3>
                    <small class="kpi-sub">5 üzerinden</small>
                </div>
            </div>
        </section>

        <!-- Charts Row 1: Donut + Bar Chart -->
        <section class="charts-row-1">
            <div class="chart-card">
                <h4 class="chart-title">Oda Tipine Göre Dağılım</h4>
                <div class="donut-chart-wrapper">
                    <div class="canvas-container">
                        <canvas id="roomTypeDonutChart"></canvas>
                    </div>
                    <div class="donut-legend" id="donutLegendContainer">
                        <div class="legend-row">
                            <span class="dot dot-coral"></span>
                            <span class="legend-name">Entire Home</span>
                            <strong class="legend-pct">%52 <small>(25.604)</small></strong>
                        </div>
                        <div class="legend-row">
                            <span class="dot dot-blue"></span>
                            <span class="legend-name">Private Room</span>
                            <strong class="legend-pct">%43 <small>(21.054)</small></strong>
                        </div>
                        <div class="legend-row">
                            <span class="dot dot-yellow"></span>
                            <span class="legend-name">Shared Room</span>
                            <strong class="legend-pct">%5 <small>(2.237)</small></strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="chart-card">
                <h4 class="chart-title">Mahallelere Göre Ortalama Fiyat</h4>
                <div class="bar-chart-wrapper">
                    <canvas id="boroughBarChart"></canvas>
                </div>
            </div>
        </section>

        <!-- Listings Section: 4x2 Grid of Cards -->
        <section class="listings-section">
            <div class="listings-header">
                <h3 class="section-heading">Tüm Evler <span class="count-txt" id="listingsCountTxt">(48.895 sonuç)</span></h3>
                <div class="sort-box">
                    <label>Sırala:</label>
                    <select id="selSortBy" class="custom-select-sm" onchange="appUI.fetchData()">
                        <option value="recommended">Önerilen</option>
                        <option value="price_asc">Fiyat: Düşükten Yükseğe</option>
                        <option value="price_desc">Fiyat: Yüksekten Düşüğe</option>
                        <option value="rating_desc">En Yüksek Puanlı</option>
                        <option value="reviews_desc">En Çok Yorum Alan</option>
                    </select>
                </div>
            </div>

            <!-- 4x2 Grid (8 Ev) -->
            <div class="listings-grid" id="listingsGrid">
                <div class="property-card" onclick="appUI.selectPropertyById(28611)">
                    <div class="card-img-wrap">
                        <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=800&q=80" alt="Clean and cozy room in Greenwich Village" />
                        <div class="card-price-badge">$120 <small>/ gece</small></div>
                        <button class="fav-btn" onclick="event.stopPropagation(); appUI.toggleFavorite(28611, this)"><i class="fa-regular fa-heart"></i></button>
                    </div>
                    <div class="card-body-content">
                        <h4 class="prop-title" title="Clean and cozy room in Greenwich Village">Clean and cozy room in Greenwich Village</h4>
                        <p class="prop-loc">📍 Manhattan, New York</p>
                        <div class="prop-amenities">
                            <span><i class="fa-solid fa-house-chimney"></i> Entire home/apt</span>
                            <span><i class="fa-solid fa-user"></i> Ev Sahibi: John</span>
                        </div>
                        <div class="prop-rating">
                            <i class="fa-solid fa-star icon-star"></i> 4.89 <span style="font-weight:400; color:var(--text-muted);">(120 yorum)</span>
                            <span class="min-nights-badge">🌙 Min. 1 Gece</span>
                        </div>
                        <button class="btn-card-compare" onclick="event.stopPropagation(); appUI.addToCompare(28611)" type="button">
                            <i class="fa-solid fa-code-compare"></i> Karşılaştır
                        </button>
                    </div>
                </div>

                <div class="property-card" onclick="appUI.selectPropertyById(28242)">
                    <div class="card-img-wrap">
                        <img src="https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?auto=format&fit=crop&w=800&q=80" alt="Cozy room in Greenwich Village" />
                        <div class="card-price-badge">$65 <small>/ gece</small></div>
                        <button class="fav-btn" onclick="event.stopPropagation(); appUI.toggleFavorite(28242, this)"><i class="fa-regular fa-heart"></i></button>
                    </div>
                    <div class="card-body-content">
                        <h4 class="prop-title" title="Cozy room in Greenwich Village">Cozy room in Greenwich Village</h4>
                        <p class="prop-loc">📍 Brooklyn, New York</p>
                        <div class="prop-amenities">
                            <span><i class="fa-solid fa-house-chimney"></i> Private room</span>
                            <span><i class="fa-solid fa-user"></i> Ev Sahibi: Sarah</span>
                        </div>
                        <div class="prop-rating">
                            <i class="fa-solid fa-star icon-star"></i> 4.75 <span style="font-weight:400; color:var(--text-muted);">(89 yorum)</span>
                            <span class="min-nights-badge">🌙 Min. 1 Gece</span>
                        </div>
                        <button class="btn-card-compare" onclick="event.stopPropagation(); appUI.addToCompare(28242)" type="button">
                            <i class="fa-solid fa-code-compare"></i> Karşılaştır
                        </button>
                    </div>
                </div>

                <div class="property-card" onclick="appUI.selectPropertyById(29012)">
                    <div class="card-img-wrap">
                        <img src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?auto=format&fit=crop&w=800&q=80" alt="Cozy Room in Bushwick" />
                        <div class="card-price-badge">$80 <small>/ gece</small></div>
                        <button class="fav-btn" onclick="event.stopPropagation(); appUI.toggleFavorite(29012, this)"><i class="fa-regular fa-heart"></i></button>
                    </div>
                    <div class="card-body-content">
                        <h4 class="prop-title" title="Cozy Room in Bushwick">Cozy Room in Bushwick</h4>
                        <p class="prop-loc">📍 Brooklyn, New York</p>
                        <div class="prop-amenities">
                            <span><i class="fa-solid fa-house-chimney"></i> Private room</span>
                            <span><i class="fa-solid fa-user"></i> Ev Sahibi: Alex</span>
                        </div>
                        <div class="prop-rating">
                            <i class="fa-solid fa-star icon-star"></i> 4.68 <span style="font-weight:400; color:var(--text-muted);">(56 yorum)</span>
                            <span class="min-nights-badge">🌙 Min. 2 Gece</span>
                        </div>
                        <button class="btn-card-compare" onclick="event.stopPropagation(); appUI.addToCompare(29012)" type="button">
                            <i class="fa-solid fa-code-compare"></i> Karşılaştır
                        </button>
                    </div>
                </div>

                <div class="property-card" onclick="appUI.selectPropertyById(31054)">
                    <div class="card-img-wrap">
                        <img src="https://images.unsplash.com/photo-1493809842364-78817add7ffb?auto=format&fit=crop&w=800&q=80" alt="Studio in Upper East Side" />
                        <div class="card-price-badge">$250 <small>/ gece</small></div>
                        <button class="fav-btn" onclick="event.stopPropagation(); appUI.toggleFavorite(31054, this)"><i class="fa-regular fa-heart"></i></button>
                    </div>
                    <div class="card-body-content">
                        <h4 class="prop-title" title="Studio in Upper East Side">Studio in Upper East Side</h4>
                        <p class="prop-loc">📍 Manhattan, New York</p>
                        <div class="prop-amenities">
                            <span><i class="fa-solid fa-house-chimney"></i> Entire home/apt</span>
                            <span><i class="fa-solid fa-user"></i> Ev Sahibi: Michael</span>
                        </div>
                        <div class="prop-rating">
                            <i class="fa-solid fa-star icon-star"></i> 4.92 <span style="font-weight:400; color:var(--text-muted);">(200 yorum)</span>
                            <span class="min-nights-badge">🌙 Min. 3 Gece</span>
                        </div>
                        <button class="btn-card-compare" onclick="event.stopPropagation(); appUI.addToCompare(31054)" type="button">
                            <i class="fa-solid fa-code-compare"></i> Karşılaştır
                        </button>
                    </div>
                </div>

                <div class="property-card" onclick="appUI.selectPropertyById(32100)">
                    <div class="card-img-wrap">
                        <img src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=800&q=80" alt="Queens'de rahat daire" />
                        <div class="card-price-badge">$90 <small>/ gece</small></div>
                        <button class="fav-btn" onclick="event.stopPropagation(); appUI.toggleFavorite(32100, this)"><i class="fa-regular fa-heart"></i></button>
                    </div>
                    <div class="card-body-content">
                        <h4 class="prop-title" title="Queens'de rahat daire">Queens'de rahat daire</h4>
                        <p class="prop-loc">📍 Queens, New York</p>
                        <div class="prop-amenities">
                            <span><i class="fa-solid fa-house-chimney"></i> Entire home/apt</span>
                            <span><i class="fa-solid fa-user"></i> Ev Sahibi: Emily</span>
                        </div>
                        <div class="prop-rating">
                            <i class="fa-solid fa-star icon-star"></i> 4.55 <span style="font-weight:400; color:var(--text-muted);">(45 yorum)</span>
                            <span class="min-nights-badge">🌙 Min. 2 Gece</span>
                        </div>
                        <button class="btn-card-compare" onclick="event.stopPropagation(); appUI.addToCompare(32100)" type="button">
                            <i class="fa-solid fa-code-compare"></i> Karşılaştır
                        </button>
                    </div>
                </div>

