<!DOCTYPE html>
<html lang="tr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NYC Rental Map</title>
    <meta name="description" content="New York City Airbnb kiralık ev haritası ve analitik paneli" />

    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <!-- Leaflet MarkerCluster CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />

    <!-- App CSS -->
    <link rel="stylesheet" href="~/css/site.css?v=@DateTime.Now.Ticks" />
</head>
<body>
    <!-- Top Navbar Header -->
    <header class="app-header">
        <div class="header-left">
            <a class="brand-logo" asp-controller="Home" asp-action="Index">
                <div class="logo-badge"><i class="fa-solid fa-location-dot"></i></div>
                <span class="brand-name">NYC Rental Map</span>
            </a>
            <nav class="nav-menu">
                <a class="nav-item active" href="javascript:void(0)" onclick="appUI.switchTab('home')">Ana Sayfa</a>
                <a class="nav-item filter-toggle-nav-btn" href="javascript:void(0)" onclick="appUI.toggleSidebarPanel()">
                    <i class="fa-solid fa-sliders"></i> Filtreler
                </a>
                <a class="nav-item" href="javascript:void(0)" onclick="appUI.switchTab('map')">Harita</a>
                <a class="nav-item" href="javascript:void(0)" onclick="appUI.switchTab('explore')">Keşfet</a>
                <a class="nav-item" href="javascript:void(0)" onclick="appUI.switchTab('statistics')">İstatistikler</a>
                <a class="nav-item fav-tab" href="javascript:void(0)" onclick="appUI.switchTab('favorites')">
                    Favorilerim <span class="fav-count-badge" id="navFavBadge">0</span>
                </a>
                <a class="nav-item" href="javascript:void(0)" onclick="appUI.switchTab('compare')">Karşılaştır</a>

            </nav>
        </div>

        <div class="header-right">

            <!-- Search bar -->
            <div class="header-search">
                <input type="text" id="topSearchInput" placeholder="Mahalle, adres veya anahtar kelime..." />
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
            </div>

            <!-- Theme Toggle -->
            <button class="icon-btn theme-toggle-btn" id="themeToggleBtn" title="Karanlık/Aydınlık Tema" onclick="appUI.toggleTheme()">
                <i class="fa-solid fa-moon" id="themeIcon"></i>
            </button>

            <!-- Notifications -->
            <button class="icon-btn notif-btn" title="Bildirimler" onclick="appUI.toggleNotifications()">
                <i class="fa-solid fa-bell"></i>
                <span class="notif-badge">3</span>
            </button>

            <!-- User Profile Pill Button (Airbnb / Pro Style) -->
            <div class="user-profile-pill" id="userProfileBtn" onclick="appUI.toggleUserMenu()" title="Hesap ve Üyelik Menüsü">
                <i class="fa-solid fa-bars menu-hamburger-icon"></i>
                <div class="user-avatar-wrap">
                    <img src="/images/default-avatar.png" alt="Tuana Kara" class="avatar-img" id="userHeaderAvatar" />
                    <span class="user-status-dot" id="userStatusDot"></span>
                </div>
                <span class="user-name" id="userHeaderName">Tuana Kara</span>
                <i class="fa-solid fa-chevron-down caret-icon"></i>
            </div>
        </div>
    </header>

    <!-- Main View Content -->
    <main role="main" class="main-wrapper">
        @RenderBody()
    </main>

    <!-- Mobile Bottom Navigation Bar (Native App Style) -->
    <nav class="mobile-bottom-nav">
        <a class="mobile-nav-item active" href="javascript:void(0)" onclick="appUI.switchTab('home'); appUI.setActiveMobileNav(this)">
            <i class="fa-solid fa-house"></i>
            <span>Ana Sayfa</span>
        </a>
        <a class="mobile-nav-item" href="javascript:void(0)" onclick="appUI.switchTab('map'); appUI.setActiveMobileNav(this)">
            <i class="fa-solid fa-map-location-dot"></i>
            <span>Harita</span>
        </a>
        <a class="mobile-nav-item" href="javascript:void(0)" onclick="appUI.toggleSidebarPanel(); appUI.setActiveMobileNav(this)">
            <i class="fa-solid fa-sliders"></i>
            <span>Filtreler</span>
        </a>
        <a class="mobile-nav-item" href="javascript:void(0)" onclick="appUI.switchTab('favorites'); appUI.setActiveMobileNav(this)">
            <i class="fa-solid fa-heart"></i>
            <span>Favoriler</span>
        </a>
        <a class="mobile-nav-item" href="javascript:void(0)" onclick="appUI.switchTab('compare'); appUI.setActiveMobileNav(this)">
            <i class="fa-solid fa-code-compare"></i>
            <span>Karşılaştır</span>
        </a>
    </nav>

    <!-- Notifications Modal Dropdown -->
    <div class="dropdown-modal notif-modal" id="notifModal">
        <div class="modal-header">
            <h3>Bildirimler</h3>
            <span class="mark-read">Tümünü Okundu İşaretle</span>
        </div>
        <div class="modal-list">
            <div class="modal-item">
                <i class="fa-solid fa-heart icon-red"></i>
                <div class="item-info">
                    <p><strong>Harika konumda daire</strong> favorilerinize eklendi.</p>
                    <small>10 dakika önce</small>
                </div>
            </div>
            <div class="modal-item">
                <i class="fa-solid fa-tag icon-blue"></i>
                <div class="item-info">
                    <p>Manhattan bölgesinde %15 fiyat indirimi!</p>
                    <small>1 saat önce</small>
                </div>
            </div>
            <div class="modal-item">
                <i class="fa-solid fa-star icon-yellow"></i>
                <div class="item-info">
                    <p>Kaydettiğiniz eve 5 yıldızlı yeni yorum yapıldı.</p>
                    <small>3 saat önce</small>
                </div>
            </div>
        </div>
    </div>

    <!-- User Profile & Auth Dropdown Modal -->
    <div class="dropdown-modal user-modal-pro" id="userModal">
        <!-- User Info Header (Logged In) -->
        <div class="user-modal-header" id="userModalLoggedInHeader">
            <div class="user-card-pro">
                <img src="/images/default-avatar.png" alt="Tuana Kara" id="userModalAvatar" />
                <div class="user-card-info">
                    <h4 id="userModalName">Tuana Kara</h4>
                    <small id="userModalEmail">tuana.kara@example.com</small>
                    <span class="badge-pro-user"><i class="fa-solid fa-shield-halved"></i> Doğrulanmış Profil</span>
                </div>
            </div>
        </div>

        <!-- Auth Actions Box (When Logged Out) -->
        <div class="user-auth-action-box" id="userModalAuthActions" style="display:none;">
            <div style="font-weight:700; font-size:0.9rem; color:var(--text-main); margin-bottom:0.4rem;">Hoş Geldiniz!</div>
            <p style="font-size:0.78rem; color:var(--text-muted); margin-bottom:0.85rem;">NYCRentalMap ile evleri favorileyin, karşılaştırın ve rezervasyon yapın.</p>
            <button type="button" class="btn-primary-coral w-100 mb-2" onclick="appUI.openLoginModal()"><i class="fa-solid fa-right-to-bracket"></i> Giriş Yap</button>
            <button type="button" class="btn-outline-dark w-100" onclick="appUI.openRegisterModal()"><i class="fa-solid fa-user-plus"></i> Hesap Aç / Kaydol</button>
        </div>

        <div class="menu-divider"></div>

        <!-- Quick Links List -->
        <div class="user-menu-links">
            <a href="javascript:void(0)" class="dropdown-link-pro" onclick="appUI.openProfileModal()"><i class="fa-solid fa-id-card icon-blue"></i> <span>Hesabım & Profilim</span></a>
            <a href="javascript:void(0)" class="dropdown-link-pro" onclick="appUI.openLoginModal()"><i class="fa-solid fa-right-to-bracket icon-coral"></i> <span>Giriş Yap / Oturum Aç</span></a>
            <a href="javascript:void(0)" class="dropdown-link-pro" onclick="appUI.openRegisterModal()"><i class="fa-solid fa-user-plus icon-mint"></i> <span>Yeni Hesap Aç / Kaydol</span></a>
            <a href="javascript:void(0)" class="dropdown-link-pro" onclick="appUI.switchTab('favorites'); appUI.toggleUserMenu();"><i class="fa-solid fa-heart icon-red"></i> <span>Beğendiğim Evler</span> <span class="fav-menu-badge" id="menuFavBadge">0</span></a>
            <a href="javascript:void(0)" class="dropdown-link-pro" onclick="appUI.switchTab('compare'); appUI.toggleUserMenu();"><i class="fa-solid fa-code-compare icon-purple"></i> <span>Karşılaştırma Listesi</span></a>
            <a href="javascript:void(0)" class="dropdown-link-pro" onclick="appUI.openHostModal()"><i class="fa-solid fa-house-chimney-user icon-green"></i> <span>Ev Sahibi Ol & İlan Ver</span></a>
        </div>

        <div class="menu-divider"></div>

        <!-- Footer Links -->
        <div class="user-menu-footer">
            <a href="javascript:void(0)" class="dropdown-link-pro" onclick="appUI.toggleTheme()"><i class="fa-solid fa-moon"></i> <span>Aydınlık / Karanlık Tema</span></a>
            <a href="javascript:void(0)" class="dropdown-link-pro text-danger" id="btnLogoutBtn" onclick="appUI.logoutUser()"><i class="fa-solid fa-right-from-bracket"></i> <span>Çıkış Yap</span></a>
        </div>
    </div>

    <!-- Property Detail Full-Page Modal -->
    <div class="detail-fullpage-overlay" id="detailModalOverlay" onclick="if(event.target===this) appUI.closeDetailModal()">
        <div class="detail-fullpage-modal">
            <!-- Close Button -->
            <button class="dfm-close" onclick="appUI.closeDetailModal()" title="Kapat">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <!-- Loading Spinner -->
            <div class="dfm-loading" id="dfmLoading">
                <div class="dfm-spinner"></div>
                <p>İlan yükleniyor...</p>
            </div>

            <!-- Content (hidden until loaded) -->
            <div class="dfm-content" id="dfmContent" style="display:none;">

                <!-- HERO SECTION: Image + Info -->
                <div class="dfm-hero">
                    <div class="dfm-hero-img">
                        <img id="dfmImg" src="" alt="İlan Görseli" />
                        <div class="dfm-img-overlay">
                            <span class="dfm-price-tag" id="dfmPrice">$120 <small>/ gece</small></span>
                        </div>
                        <button class="dfm-fav-btn" id="dfmFavBtn" onclick="event.stopPropagation(); appUI.toggleDetailFav()">
                            <i class="fa-regular fa-heart" id="dfmFavIcon"></i>
                        </button>
                    </div>
                    <div class="dfm-hero-info">
                        <div class="dfm-badges">
                            <span class="dfm-badge dfm-badge-room" id="dfmBadgeRoom">Entire home/apt</span>
                            <span class="dfm-badge dfm-badge-borough" id="dfmBadgeBorough">Manhattan</span>
                        </div>
                        <h1 class="dfm-title" id="dfmTitle">İlan Başlığı</h1>
                        <p class="dfm-location" id="dfmLocation"><i class="fa-solid fa-location-dot"></i> Manhattan, New York</p>

                        <div class="dfm-rating-row" id="dfmRatingRow">
                            <div class="dfm-stars">
                                <i class="fa-solid fa-star"></i>
                                <span id="dfmRating">4.89</span>
                            </div>
                            <span class="dfm-review-count">(<span id="dfmReviewCount">120</span> yorum)</span>
                        </div>

                        <div class="dfm-host-row">
                            <div class="dfm-host-avatar">
                                <i class="fa-solid fa-user-tie"></i>
                            </div>
                            <div>
                                <span class="dfm-host-label">Ev Sahibi</span>
                                <strong id="dfmHostName">John</strong>
                                <span class="dfm-host-listings">(<span id="dfmHostListings">5</span> ilan)</span>
                            </div>
                        </div>

                        <hr class="dfm-divider" />

                        <!-- Stats Grid -->
                        <div class="dfm-stats-grid">
                            <div class="dfm-stat">
                                <i class="fa-solid fa-bed"></i>
                                <span id="dfmBeds">2</span>
                                <small>Yatak</small>
                            </div>
                            <div class="dfm-stat">
                                <i class="fa-solid fa-user-group"></i>
                                <span id="dfmGuests">4</span>
                                <small>Misafir</small>
                            </div>
                            <div class="dfm-stat">
                                <i class="fa-solid fa-moon"></i>
                                <span id="dfmMinNights">1</span>
                                <small>Min. Gece</small>
                            </div>
                            <div class="dfm-stat">
                                <i class="fa-solid fa-calendar-check"></i>
                                <span id="dfmAvailability">365</span>
                                <small>Gün Müsait</small>
                            </div>
                            <div class="dfm-stat">
                                <i class="fa-solid fa-chart-line"></i>
                                <span id="dfmReviewsPerMonth">2.5</span>
                                <small>Yorum/Ay</small>
                            </div>
                            <div class="dfm-stat">
                                <i class="fa-solid fa-clock"></i>
                                <span id="dfmLastReview">-</span>
                                <small>Son Yorum</small>
                            </div>
                        </div>

                        <div style="display:flex; gap:0.5rem; margin-top:0.4rem;">
                            <button class="dfm-reserve-btn" onclick="appUI.openBookingModal()" style="flex:1;">
                                <i class="fa-solid fa-calendar-check"></i> Hemen Rezerve Et
                            </button>
                            <button class="dfm-compare-action-btn" onclick="appUI.addActivePropertyToCompare(event)" type="button" title="Karşılaştırma Listesine Ekle">
                                <i class="fa-solid fa-code-compare"></i> Karşılaştır
                            </button>
                        </div>
                    </div>
                </div>

                <!-- MINI MAP SECTION -->
                <div class="dfm-section">
                    <h3 class="dfm-section-title"><i class="fa-solid fa-map-location-dot"></i> Konum</h3>
                    <div class="dfm-map-wrap" id="dfmMapWrap"></div>
                </div>

                <!-- REVIEWS SECTION -->
                <div class="dfm-section">
                    <h3 class="dfm-section-title"><i class="fa-solid fa-comments"></i> Yorumlar <span class="dfm-section-count" id="dfmReviewSectionCount"></span></h3>
                    <div class="dfm-reviews-grid" id="dfmReviewsGrid">
                        <!-- JS renders review cards here -->
                    </div>
                </div>

                <!-- SIMILAR LISTINGS SECTION -->
                <div class="dfm-section">
                    <h3 class="dfm-section-title"><i class="fa-solid fa-house-circle-check"></i> Benzer İlanlar</h3>
                    <div class="dfm-similar-scroll" id="dfmSimilarScroll">
                        <!-- JS renders similar listing cards here -->
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Booking / Reservation Professional Modal -->
    <div class="full-modal-overlay" id="bookingModalOverlay" onclick="if(event.target===this) appUI.closeBookingModal()">
        <div class="booking-modal-card">
            <button class="modal-close-icon" onclick="appUI.closeBookingModal()"><i class="fa-solid fa-xmark"></i></button>

            <!-- Booking Header -->
            <div class="booking-header">
                <div class="booking-header-icon"><i class="fa-solid fa-calendar-check"></i></div>
                <div>
                    <h2>Rezervasyon Yap</h2>
                    <p id="bookingPropTitle">Seçilen Ev Adı</p>
                </div>
            </div>

            <!-- Booking Progress Bar -->
            <div class="booking-steps-bar">
                <div class="step-item active" id="step1Indicator" onclick="appUI.goToBookingStep(1)" style="cursor:pointer;"><span>1</span> Tarih ve Misafir</div>
                <div class="step-line"></div>
                <div class="step-item" id="step2Indicator" onclick="appUI.goToBookingStep(2)" style="cursor:pointer;"><span>2</span> Kişisel Bilgiler</div>
                <div class="step-line"></div>
                <div class="step-item" id="step3Indicator" onclick="appUI.goToBookingStep(3)" style="cursor:pointer;"><span>3</span> Ödeme & Onay</div>
            </div>

            <!-- Booking Form Content -->
            <form id="bookingForm" onsubmit="event.preventDefault(); appUI.submitBooking();">
                <!-- Step 1: Dates & Guests -->
                <div class="booking-step-content active" id="bookingStep1">
                    <div class="form-row-2">
                        <div class="form-group">
                            <label><i class="fa-solid fa-calendar-day"></i> Giriş Tarihi</label>
                            <input type="date" id="bookCheckIn" class="custom-input-lg" required onchange="appUI.calculateBookingTotal()" />
                        </div>
                        <div class="form-group">
                            <label><i class="fa-solid fa-calendar-day"></i> Çıkış Tarihi</label>
                            <input type="date" id="bookCheckOut" class="custom-input-lg" required onchange="appUI.calculateBookingTotal()" />
                        </div>
                    </div>

                    <div class="form-row-2 mt-3">
                        <div class="form-group">
                            <label><i class="fa-solid fa-user-group"></i> Misafir Sayısı</label>
                            <select id="bookGuestsCount" class="custom-select-lg" onchange="appUI.calculateBookingTotal()">
                                <option value="1">1 Misafir</option>
                                <option value="2" selected>2 Misafir</option>
                                <option value="3">3 Misafir</option>
                                <option value="4">4 Misafir</option>
                                <option value="5">5+ Misafir</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label><i class="fa-solid fa-bed"></i> Oda Tipi Tercihi</label>
                            <input type="text" id="bookRoomTypeReadonly" class="custom-input-lg" readonly value="Entire home/apt" />
                        </div>
                    </div>

                    <!-- Price Summary Card -->
                    <div class="price-calculation-card mt-3">
                        <div class="calc-row">
                            <span id="calcNightRate">$120 x <strong id="calcNightCount">3 gece</strong></span>
                            <strong id="calcBasePrice">$360</strong>
                        </div>
                        <div class="calc-row">
                            <span>Temizlik Ücreti</span>
                            <strong>$45</strong>
                        </div>
                        <div class="calc-row">
                            <span>Hizmet & Yazılım Ücreti</span>
                            <strong>$30</strong>
                        </div>
                        <hr />
                        <div class="calc-row total-row">
                            <span>Toplam Tutar</span>
                            <span class="total-amount-txt" id="calcTotalPrice">$435</span>
                        </div>
                    </div>

                    <div class="booking-footer-btn mt-4">
                        <button type="button" class="btn-primary-coral w-100 btn-lg" onclick="appUI.goToBookingStep(2)">Devam Et: İletişim Bilgileri <i class="fa-solid fa-arrow-right"></i></button>
                    </div>
                </div>

                <!-- Step 2: Personal Information -->
                <div class="booking-step-content" id="bookingStep2">
                    <div class="form-row-2">
                        <div class="form-group">
                            <label><i class="fa-solid fa-user"></i> Adınız</label>
                            <input type="text" id="bookFirstName" class="custom-input-lg" placeholder="Ahmet" required />
                        </div>
                        <div class="form-group">
                            <label><i class="fa-solid fa-user"></i> Soyadınız</label>
                            <input type="text" id="bookLastName" class="custom-input-lg" placeholder="Yılmaz" required />
                        </div>
                    </div>

                    <div class="form-row-2 mt-3">
                        <div class="form-group">
                            <label><i class="fa-solid fa-envelope"></i> E-Posta Adresi</label>
                            <input type="email" id="bookEmail" class="custom-input-lg" placeholder="ornek@domain.com" required />
                        </div>
                        <div class="form-group">
                            <label><i class="fa-solid fa-phone"></i> Telefon Numarası</label>
                            <input type="tel" id="bookPhone" class="custom-input-lg" placeholder="+90 5XX XXX XX XX" required />
                        </div>
                    </div>

                    <div class="form-group mt-3">
                        <label><i class="fa-solid fa-comment-dots"></i> Ev Sahibine Özel Not (Opsiyonel)</label>
                        <textarea id="bookNotes" class="custom-textarea" rows="3" placeholder="Varış saatiniz veya özel istekleriniz..."></textarea>
                    </div>

                    <div class="booking-btn-row mt-4">
                        <button type="button" class="btn-outline-dark btn-lg" onclick="appUI.goToBookingStep(1)"><i class="fa-solid fa-arrow-left"></i> Geri</button>
                        <button type="button" class="btn-primary-coral btn-lg flex-1" onclick="appUI.goToBookingStep(3)">Ödeme Adımına Geç <i class="fa-solid fa-arrow-right"></i></button>
                    </div>
                </div>

                <!-- Step 3: Payment & Confirmation -->
                <div class="booking-step-content" id="bookingStep3">
                    <div class="payment-card-box">
                        <div class="payment-card-header">
                            <span><i class="fa-solid fa-credit-card"></i> Kredi veya Banka Kartı</span>
                            <div class="card-icons">
                                <i class="fa-brands fa-cc-visa"></i>
                                <i class="fa-brands fa-cc-mastercard"></i>
                            </div>
                        </div>

                        <div class="form-group mt-3">
                            <label>Kart Üzerindeki İsim</label>
                            <input type="text" id="cardHolder" class="custom-input-lg" placeholder="AHMET YILMAZ" required oninput="appUI.clearFieldError('cardHolder')" />
                        </div>

                        <div class="form-group mt-3">
                            <label>Kart Numarası</label>
                            <input type="text" id="cardNumber" class="custom-input-lg" placeholder="4543 •••• •••• 8890" maxlength="19" required oninput="appUI.clearFieldError('cardNumber')" />
                        </div>

                        <div class="form-row-2 mt-3">
                            <div class="form-group">
                                <label>Son Kullanma Tarihi</label>
                                <input type="text" id="cardExpiry" class="custom-input-lg" placeholder="MM/YY" maxlength="5" required oninput="appUI.clearFieldError('cardExpiry')" />
                            </div>
                            <div class="form-group">
                                <label>CVC / CVV</label>
                                <input type="text" id="cardCvc" class="custom-input-lg" placeholder="•••" maxlength="4" required oninput="appUI.clearFieldError('cardCvc')" />
                            </div>
                        </div>
                    </div>

                    <div class="security-badge-box mt-3">
                        <i class="fa-solid fa-shield-halved icon-green"></i>
                        <span>256-Bit SSL Güvenli Şifreleme ile ödemeniz koruma altındadır.</span>
                    </div>

                    <div class="booking-btn-row mt-4">
                        <button type="button" class="btn-outline-dark btn-lg" onclick="appUI.goToBookingStep(2)"><i class="fa-solid fa-arrow-left"></i> Geri</button>
                        <button type="submit" class="btn-success-green btn-lg flex-1" id="btnConfirmBooking"><i class="fa-solid fa-lock"></i> Rezervasyonu Onayla ve Öde (<span id="btnPayAmount">$435</span>)</button>
                    </div>
                </div>

                <!-- Success Screen State -->
                <div class="booking-step-content text-center py-4" id="bookingSuccessScreen" style="display:none;">
                    <div class="success-icon-wrap">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <h2 class="mt-3" style="color:var(--text-color); font-weight:800;">Rezervasyonunuz Başarıyla Alındı!</h2>
                    <p class="text-muted mt-2" style="font-size:0.95rem; max-width:480px; margin:0 auto;">
                        Rezervasyon onayınız ve detaylar <strong id="successCustomerEmail">ornek@domain.com</strong> adresine e-posta olarak gönderilmiştir.
