<!DOCTYPE html>
<html lang="tr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NYC Rental Map</title>
    <link rel="icon" type="image/jpeg" href="~/images/nyc_app_icon.jpg" />
    <meta name="description" content="New York City Airbnb kiralık ev haritası ve analitik paneli" />

    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <!-- Leaflet MarkerCluster CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />

    <!-- PWA Application Meta & Icons -->
    <meta name="theme-color" content="#C69B7B">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="NYC Rental Map">
    <link rel="apple-touch-icon" href="/images/app-icon-192.png">
    <link rel="manifest" href="/manifest.json">

    <!-- App CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Navbar Header -->
    <header class="app-header">
        <div class="header-left">
            <a class="brand-logo" asp-controller="Home" asp-action="Index">
                <div class="logo-badge"><i class="fa-solid fa-location-dot"></i></div>
                <span class="brand-name">NYC Rental Map</span>
            </a>
            <nav class="nav-menu">
                <a class="nav-item active" href="javascript:void(0)" onclick="appUI.switchTab('home')">Ana Sayfa</a>
                <a class="nav-item filter-toggle-nav-btn" href="javascript:void(0)" onclick="appUI.toggleSidebarPanel()">
                    <i class="fa-solid fa-sliders"></i> Filtreler
                </a>
                <a class="nav-item" href="javascript:void(0)" onclick="appUI.switchTab('map')">Harita</a>
                <a class="nav-item" href="javascript:void(0)" onclick="appUI.switchTab('statistics')">İstatistikler</a>
                <a class="nav-item" href="javascript:void(0)" onclick="appUI.switchTab('explore')">Keşfet</a>
                <a class="nav-item fav-tab" href="javascript:void(0)" onclick="appUI.switchTab('favorites')">
                    Favorilerim <span class="fav-count-badge" id="navFavBadge">0</span>
                </a>
                <a class="nav-item" href="javascript:void(0)" onclick="appUI.switchTab('compare')">Karşılaştır</a>
            </nav>
        </div>

        <div class="header-right">


            <!-- Search bar -->
            <div class="header-search">
                <input type="text" id="topSearchInput" placeholder="Mahalle, adres veya anahtar kelime..." />
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
            </div>

            <!-- Theme Toggle -->
            <button class="icon-btn theme-toggle-btn" id="themeToggleBtn" title="Karanlık/Aydınlık Tema" onclick="appUI.toggleTheme()">
                <i class="fa-solid fa-moon" id="themeIcon"></i>
            </button>

            <!-- Notifications -->
            <button class="icon-btn notif-btn" title="Bildirimler" onclick="appUI.toggleNotifications()">
                <i class="fa-solid fa-bell"></i>
                <span class="notif-badge" id="notifBadge" style="display:none;">0</span>
            </button>

            <!-- User Profile Pill Button (Airbnb / Pro Style) -->
            <div class="user-profile-pill" id="userProfileBtn" onclick="appUI.toggleUserMenu()" title="Hesap ve Üyelik Menüsü">
                <i class="fa-solid fa-bars menu-hamburger-icon"></i>
                <div class="user-avatar-wrap">
                    <img src="/images/default-avatar.png" alt="Tuana Kara" class="avatar-img" id="userHeaderAvatar" />
                    <span class="user-status-dot" id="userStatusDot"></span>
                </div>
                <span class="user-name" id="userHeaderName">Tuana Kara</span>
                <i class="fa-solid fa-chevron-down caret-icon"></i>
            </div>
        </div>
    </header>

    <!-- Main View Content -->
    <main role="main" class="main-wrapper">
        @RenderBody()
    </main>

    <!-- Professional Modern Footer -->
    <footer class="app-footer-pro">
        <div class="footer-container">
            <div class="footer-grid">
                <!-- Column 1: Brand Info -->
                <div class="footer-col brand-col">
                    <div class="footer-brand-logo">
                        <div class="logo-badge"><i class="fa-solid fa-location-dot"></i></div>
                        <span class="brand-name">NYC Rental Map</span>
                    </div>
                    <p class="footer-desc">
                        New York genelinde 48.800+ kiralık ev ilanını interaktif harita üzerinde keşfedin, canlı fiyat trendlerini analiz edin ve hayalinizdeki evi bulun.
                    </p>
                    <div class="footer-social-links">
                        <a href="https://github.com/karatuana-creator/NYCRentalMap.git" target="_blank" class="social-icon" title="GitHub Repository"><i class="fa-brands fa-github"></i></a>
                        <a href="javascript:void(0)" class="social-icon" title="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                        <a href="javascript:void(0)" class="social-icon" title="Twitter / X"><i class="fa-brands fa-x-twitter"></i></a>
                        <a href="javascript:void(0)" class="social-icon" title="Instagram"><i class="fa-brands fa-instagram"></i></a>
                    </div>
                </div>

                <!-- Column 2: Quick Links -->
                <div class="footer-col">
                    <h4 class="footer-title">Hızlı Erişim</h4>
                    <ul class="footer-links">
                        <li><a href="javascript:void(0)" onclick="appUI.switchTab('home')"><i class="fa-solid fa-angle-right"></i> Ana Sayfa</a></li>
                        <li><a href="javascript:void(0)" onclick="appUI.switchTab('map')"><i class="fa-solid fa-angle-right"></i> İnteraktif Harita</a></li>
                        <li><a href="javascript:void(0)" onclick="appUI.switchTab('explore')"><i class="fa-solid fa-angle-right"></i> Keşfet & Rehber</a></li>
                        <li><a href="javascript:void(0)" onclick="appUI.switchTab('statistics')"><i class="fa-solid fa-angle-right"></i> Piyasa İstatistikleri</a></li>
                        <li><a href="javascript:void(0)" onclick="appUI.switchTab('favorites')"><i class="fa-solid fa-angle-right"></i> Favorilerim</a></li>
                        <li><a href="javascript:void(0)" onclick="appUI.switchTab('compare')"><i class="fa-solid fa-angle-right"></i> Karşılaştırma Modu</a></li>
                    </ul>
                </div>

                <!-- Column 3: Boroughs -->
                <div class="footer-col">
                    <h4 class="footer-title">Popüler Bölgeler</h4>
                    <ul class="footer-links">
                        <li><a href="javascript:void(0)" onclick="appUI.applySavedSearch(102)"><i class="fa-solid fa-building"></i> Manhattan Kiralık Evler</a></li>
                        <li><a href="javascript:void(0)" onclick="appUI.switchTab('explore')"><i class="fa-solid fa-city"></i> Brooklyn Loft & Daireler</a></li>
                        <li><a href="javascript:void(0)" onclick="appUI.switchTab('explore')"><i class="fa-solid fa-tree"></i> Queens Kültürel İlanlar</a></li>
                        <li><a href="javascript:void(0)" onclick="appUI.applySavedSearch(101)"><i class="fa-solid fa-house-user"></i> Bronx Bütçe Dostu Daireler</a></li>
                        <li><a href="javascript:void(0)" onclick="appUI.switchTab('explore')"><i class="fa-solid fa-water"></i> Staten Island Evleri</a></li>
                    </ul>
                </div>

                <!-- Column 4: Platform Features & Contact -->
                <div class="footer-col">
                    <h4 class="footer-title">Platform Özellikleri</h4>
                    <div class="footer-features-badges">
                        <span class="f-badge"><i class="fa-solid fa-mobile-screen"></i> PWA Mobil App</span>
                        <span class="f-badge"><i class="fa-solid fa-bookmark"></i> Kayıtlı Aramalar</span>
                        <span class="f-badge"><i class="fa-solid fa-robot"></i> AI NYC Asistan</span>
                        <span class="f-badge"><i class="fa-solid fa-chart-pie"></i> Canlı Grafikler</span>
                    </div>
                    <div class="footer-contact-info" style="margin-top: 1rem;">
                        <div class="f-contact-item"><i class="fa-solid fa-envelope"></i> <span>tuana.kara@nycrentalmap.com</span></div>
                        <div class="f-contact-item"><i class="fa-solid fa-shield-halved"></i> <span>Gelişmiş Güvenli Veri Altyapısı</span></div>
                    </div>
                </div>
            </div>

            <!-- Footer Bottom Bar -->
            <div class="footer-bottom">
                <div class="footer-bottom-left">
                    <span>© 2026 <strong>NYC Rental Map</strong>. Tüm hakları saklıdır.</span>
                </div>
                <div class="footer-bottom-right">
                    <span>Tuana Kara tarafından ❤️ ile geliştirildi.</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Mobile Bottom Navigation Bar (Native App Style) -->
    <nav class="mobile-bottom-nav">
        <a class="mobile-nav-item active" href="javascript:void(0)" onclick="appUI.switchTab('home'); appUI.setActiveMobileNav(this)">
            <i class="fa-solid fa-house"></i>
            <span>Ana Sayfa</span>
        </a>
        <a class="mobile-nav-item" href="javascript:void(0)" onclick="appUI.switchTab('map'); appUI.setActiveMobileNav(this)">
            <i class="fa-solid fa-map-location-dot"></i>
            <span>Harita</span>
        </a>
        <a class="mobile-nav-item" href="javascript:void(0)" onclick="appUI.toggleSidebarPanel(); appUI.setActiveMobileNav(this)">
            <i class="fa-solid fa-sliders"></i>
            <span>Filtreler</span>
        </a>
        <a class="mobile-nav-item" href="javascript:void(0)" onclick="appUI.switchTab('favorites'); appUI.setActiveMobileNav(this)">
            <i class="fa-solid fa-heart"></i>
            <span>Favoriler</span>
        </a>
        <a class="mobile-nav-item" href="javascript:void(0)" onclick="appUI.switchTab('compare'); appUI.setActiveMobileNav(this)">
            <i class="fa-solid fa-code-compare"></i>
            <span>Karşılaştır</span>
        </a>
    </nav>

    <!-- Notifications Modal Dropdown -->
    <div class="dropdown-modal notif-modal" id="notifModal" style="width: 380px; max-height: 480px; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.12); padding: 0;">
        <div class="modal-header" style="background: var(--bg-card); border-bottom: 1px solid var(--border-color); padding: 1.25rem 1.5rem; border-radius: 16px 16px 0 0; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 10;">
            <h3 style="margin: 0; font-size: 1.1rem; font-weight: 800; color: var(--text-main); display: flex; align-items: center; gap: 0.5rem;"><i class="fa-solid fa-bell" style="color: #c69b7b;"></i> Bildirimler</h3>
            <span class="mark-read" onclick="appUI.markAllNotifsRead()" style="cursor:pointer; font-size: 0.8rem; font-weight: 700; color: #10b981; transition: opacity 0.2s;"><i class="fa-solid fa-check-double"></i> Tümünü Okundu İşaretle</span>
        </div>
        <div class="modal-list" id="notifList" style="padding: 0; margin: 0; overflow-y: auto; max-height: 380px;">
            
            <div class="modal-item" style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-color); display: flex; gap: 1rem; align-items: flex-start; cursor: pointer; transition: background 0.2s; background: rgba(198, 155, 123, 0.05);" onmouseover="this.style.background='var(--bg-hover)'" onmouseout="this.style.background='rgba(198, 155, 123, 0.05)'">
                <div style="background: rgba(244, 63, 94, 0.1); color: var(--accent-red); width: 40px; height: 40px; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 1.1rem; flex-shrink: 0;">
                    <i class="fa-solid fa-arrow-trend-up"></i>
                </div>
                <div class="item-info" style="flex: 1;">
                    <p style="margin: 0 0 0.4rem 0; font-size: 0.9rem; color: var(--text-main); line-height: 1.4;"><strong>Fiyat Güncellemesi!</strong> Favorilerinize eklediğiniz <em>"Luxury Loft in SoHo"</em> isimli evin fiyatı gecelik <strong>$145</strong> olarak güncellendi. SQL veritabanından alınan canlı veri.</p>
                    <small style="color: var(--text-muted); font-size: 0.75rem; display: flex; align-items: center; gap: 0.3rem;"><i class="fa-regular fa-clock"></i> 5 dk önce</small>
                </div>
                <div style="width: 8px; height: 8px; background: var(--accent-red); border-radius: 50%; flex-shrink: 0; margin-top: 6px;"></div>
            </div>

            <div class="modal-item" style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-color); display: flex; gap: 1rem; align-items: flex-start; cursor: pointer; transition: background 0.2s; background: rgba(198, 155, 123, 0.05);" onmouseover="this.style.background='var(--bg-hover)'" onmouseout="this.style.background='rgba(198, 155, 123, 0.05)'">
                <div style="background: rgba(16, 185, 129, 0.1); color: #10b981; width: 40px; height: 40px; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 1.1rem; flex-shrink: 0;">
                    <i class="fa-solid fa-tags"></i>
                </div>
                <div class="item-info" style="flex: 1;">
                    <p style="margin: 0 0 0.4rem 0; font-size: 0.9rem; color: var(--text-main); line-height: 1.4;"><strong>Fırsat Yakaladınız!</strong> Kayıtlı aramalarınızdaki <em>"Brooklyn - Bütçe Dostu"</em> filtrenize uygun 12 yeni ilan sisteme eklendi.</p>
                    <small style="color: var(--text-muted); font-size: 0.75rem; display: flex; align-items: center; gap: 0.3rem;"><i class="fa-regular fa-clock"></i> 1 saat önce</small>
                </div>
                <div style="width: 8px; height: 8px; background: #10b981; border-radius: 50%; flex-shrink: 0; margin-top: 6px;"></div>
            </div>

            <div class="modal-item" style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-color); display: flex; gap: 1rem; align-items: flex-start; cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='var(--bg-hover)'" onmouseout="this.style.background='transparent'">
                <div style="background: var(--bg-hover); color: var(--text-muted); width: 40px; height: 40px; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 1.1rem; flex-shrink: 0;">
                    <i class="fa-solid fa-hand-wave"></i>
                </div>
                <div class="item-info" style="flex: 1;">
                    <p style="margin: 0 0 0.4rem 0; font-size: 0.9rem; color: var(--text-muted); line-height: 1.4;">Sisteme hoş geldiniz! Uygulamamızdaki en güncel kiralama fırsatları ve değişimleri buradan takip edebilirsiniz.</p>
                    <small style="color: var(--text-muted); font-size: 0.75rem; display: flex; align-items: center; gap: 0.3rem;"><i class="fa-regular fa-clock"></i> Dün</small>
                </div>
            </div>

        </div>
    </div>

    <!-- User Profile & Auth Dropdown Modal -->
    <div class="dropdown-modal user-modal-pro" id="userModal">
        <!-- User Info Header (Logged In) -->
        <div class="user-modal-header" id="userModalLoggedInHeader">
            <div class="user-card-pro">
                <img src="/images/default-avatar.png" alt="Tuana Kara" id="userModalAvatar" />
                <div class="user-card-info">
                    <h4 id="userModalName">Tuana Kara</h4>
                    <small id="userModalEmail">tuana.kara@example.com</small>
                    <span class="badge-pro-user"><i class="fa-solid fa-shield-halved"></i> Doğrulanmış Profil</span>
                </div>
            </div>
        </div>

        <!-- Auth Actions Box (When Logged Out) -->
        <div class="user-auth-action-box" id="userModalAuthActions" style="display:none;">
            <div style="font-weight:700; font-size:0.9rem; color:var(--text-main); margin-bottom:0.4rem;">Hoş Geldiniz!</div>
            <p style="font-size:0.78rem; color:var(--text-muted); margin-bottom:0.85rem;">NYCRentalMap ile evleri favorileyin, karşılaştırın ve rezervasyon yapın.</p>
            <button type="button" class="btn-primary-coral w-100 mb-2" onclick="appUI.openLoginModal()"><i class="fa-solid fa-right-to-bracket"></i> Giriş Yap</button>
            <button type="button" class="btn-outline-dark w-100" onclick="appUI.openRegisterModal()"><i class="fa-solid fa-user-plus"></i> Hesap Aç / Kaydol</button>
        </div>

        <div class="menu-divider"></div>

        <!-- Quick Links List -->
        <div class="user-menu-links">
            <a href="javascript:void(0)" class="dropdown-link-pro" onclick="appUI.openProfileModal()"><i class="fa-solid fa-id-card icon-blue"></i> <span>Hesabım & Profilim</span></a>
            <a href="javascript:void(0)" class="dropdown-link-pro" onclick="appUI.openLoginModal()"><i class="fa-solid fa-right-to-bracket icon-coral"></i> <span>Giriş Yap / Oturum Aç</span></a>
            <a href="javascript:void(0)" class="dropdown-link-pro" onclick="appUI.openRegisterModal()"><i class="fa-solid fa-user-plus icon-mint"></i> <span>Yeni Hesap Aç / Kaydol</span></a>
            <a href="javascript:void(0)" class="dropdown-link-pro" onclick="appUI.switchTab('favorites'); appUI.toggleUserMenu();"><i class="fa-solid fa-heart icon-red"></i> <span>Beğendiğim Evler</span> <span class="fav-menu-badge" id="menuFavBadge">0</span></a>
            <a href="javascript:void(0)" class="dropdown-link-pro" onclick="appUI.switchTab('compare'); appUI.toggleUserMenu();"><i class="fa-solid fa-code-compare icon-purple"></i> <span>Karşılaştırma Listesi</span></a>
            <a href="javascript:void(0)" class="dropdown-link-pro" onclick="appUI.openHostModal()"><i class="fa-solid fa-house-chimney-user icon-green"></i> <span>Ev Sahibi Ol & İlan Ver</span></a>
        </div>

        <div class="menu-divider"></div>

        <!-- Footer Links -->
        <div class="user-menu-footer">
            <a href="javascript:void(0)" class="dropdown-link-pro" onclick="document.getElementById('userModal')?.classList.remove('show'); var m=document.getElementById('settingsModalOverlay'); if(m){ m.style.display='flex'; m.classList.add('show'); }"><i class="fa-solid fa-gear" style="color:var(--text-muted);"></i> <span>Ayarlar & Tercihler</span></a>
            
            <div class="dropdown-link-pro" style="display:flex; justify-content:space-between; align-items:center; cursor:default; position:relative;">
                <div style="display:flex; align-items:center; gap:10px;">
                    <i class="fa-solid fa-money-bill-wave" style="color:#10b981; width:20px; text-align:center;"></i> <span style="font-size:0.85rem; font-weight:600; color:var(--text-main);">Para Birimi</span>
                </div>
                <div class="currency-dropdown-wrap">
                    <div class="currency-btn" id="currencyBtn" onclick="appUI.toggleCurrencyDropdown()" style="background:var(--bg-input); border:1px solid var(--border-color); color:var(--text-main); padding:4px 8px; border-radius:8px; font-weight:700; font-size:0.75rem; cursor:pointer; display:flex; align-items:center; gap:4px;">
                        <span id="currencyBadgeSymbol" style="color:var(--accent-red); font-weight:800;">$</span>
                        <span id="currencyBadgeCode">USD</span>
                        <i class="fa-solid fa-chevron-down" style="font-size:0.65rem; color:var(--text-muted);"></i>
                    </div>
                    <div class="currency-menu" id="currencyMenu" style="position:absolute; top:calc(100% + 4px); right:0; background:var(--bg-card); border:1px solid var(--border-color); border-radius:12px; box-shadow:0 10px 25px rgba(0,0,0,0.15); width:150px; padding:0.4rem; z-index:9999; animation:dfmSlideUp 0.2s cubic-bezier(0.16, 1, 0.3, 1);">
                        <div class="currency-option active" id="optCurrUSD" onclick="appUI.selectCurrency('USD')" style="padding:6px 10px; border-radius:8px; display:flex; align-items:center; justify-content:space-between; cursor:pointer; font-size:0.8rem; font-weight:700; color:var(--text-main);">
                            <span><strong style="color:var(--accent-red); margin-right:4px;">$</strong> USD</span>
                            <i class="fa-solid fa-check c-check" id="chkCurrencyUSD" style="color:var(--accent-red); font-size:0.75rem;"></i>
                        </div>
                        <div class="currency-option" id="optCurrTRY" onclick="appUI.selectCurrency('TRY')" style="padding:6px 10px; border-radius:8px; display:flex; align-items:center; justify-content:space-between; cursor:pointer; font-size:0.8rem; font-weight:700; color:var(--text-main);">
                            <span><strong style="color:var(--accent-red); margin-right:4px;">₺</strong> TRY</span>
                            <i class="fa-solid fa-check c-check" id="chkCurrencyTRY" style="display:none; color:var(--accent-red); font-size:0.75rem;"></i>
                        </div>
                        <div class="currency-option" id="optCurrEUR" onclick="appUI.selectCurrency('EUR')" style="padding:6px 10px; border-radius:8px; display:flex; align-items:center; justify-content:space-between; cursor:pointer; font-size:0.8rem; font-weight:700; color:var(--text-main);">
                            <span><strong style="color:var(--accent-red); margin-right:4px;">€</strong> EUR</span>
                            <i class="fa-solid fa-check c-check" id="chkCurrencyEUR" style="display:none; color:var(--accent-red); font-size:0.75rem;"></i>
                        </div>
                        <div class="currency-option" id="optCurrGBP" onclick="appUI.selectCurrency('GBP')" style="padding:6px 10px; border-radius:8px; display:flex; align-items:center; justify-content:space-between; cursor:pointer; font-size:0.8rem; font-weight:700; color:var(--text-main);">
                            <span><strong style="color:var(--accent-red); margin-right:4px;">£</strong> GBP</span>
                            <i class="fa-solid fa-check c-check" id="chkCurrencyGBP" style="display:none; color:var(--accent-red); font-size:0.75rem;"></i>
                        </div>
                    </div>
                </div>
            </div>

            <a href="javascript:void(0)" class="dropdown-link-pro" onclick="appUI.toggleTheme()"><i class="fa-solid fa-moon" style="color:var(--text-muted);"></i> <span>Aydınlık / Karanlık Tema</span></a>
            <a href="javascript:void(0)" class="dropdown-link-pro text-danger" id="btnLogoutBtn" onclick="appUI.logoutUser()"><i class="fa-solid fa-right-from-bracket"></i> <span>Çıkış Yap</span></a>
        </div>
    </div>
    <!-- Settings & Preferences Modal Overlay -->
    <div class="full-modal-overlay" id="settingsModalOverlay" onclick="if(event.target===this) appUI.closeSettingsModal()">
        <div style="background:var(--bg-card); width:100%; max-width:540px; border-radius:24px; padding:1.75rem; border:1px solid var(--border-color); box-shadow:0 25px 70px rgba(0,0,0,0.5); margin:auto; animation:dfmSlideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem;">
